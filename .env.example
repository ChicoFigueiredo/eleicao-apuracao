# Banco local (não versione o banco nem arquivos .env reais)
DATABASE_PATH=state/eleicao.db
PORT=7786

# Origem oficial TSE: configurar com a URL e chave divulgadas para o arquivo escolhido.
TSE_RESULT_URL=
TSE_JWS_PUBLIC_KEY_PATH=

# Credenciais do Basic Auth configurado pelo script de Nginx na VPS.
NGINX_BASIC_AUTH_USER=
NGINX_BASIC_AUTH_PASSWORD=
