# Banco local (não versione o banco nem arquivos .env reais)
DATABASE_PATH=state/eleicao.db
PORT=7786

# Origem oficial TSE: configurar com a URL e chave divulgadas para o arquivo escolhido.
TSE_RESULT_URL=
TSE_JWS_PUBLIC_KEY_PATH=

# Credenciais do Basic Auth exigido pelo Caddy da Borda na VPS. Só a senha em claro vive
# aqui; na VPS fica apenas o hash bcrypt em /etc/caddy/segredos/eleicoes-apuracao.auth.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
